# Copy this file to .env and fill in your values
# Never commit .env to version control

# Required for the LLM-backed generate/explain/hint paths. When unset the
# backend falls back to the rule-based implementations.
GROQ_API_KEY=your_groq_api_key_here

# Optional: shared secret that clients must send in the X-API-Key header.
# When unset the API is open (development mode).
# CIRCUITMIND_API_KEY=your_shared_secret

# Optional: Redis URI for the rate limiter so limits hold across serverless
# instances. When unset slowapi keeps counters in memory (local dev).
# RATE_LIMIT_REDIS_URL=redis://default:password@host:6379/0

# Optional: comma-separated list of allowed CORS origins.
# Default is NOT "*" — it is the local development origins listed below.
# ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000
